    {
      "id": "fill-no-hats",
      "title": "The fill",
      "goal": "A four-bar phrase: hats in bars 1–3, none in bar 4, and a snare fill in bar 4.",
      "concept": "",
      "shape": "kata",
      "starter": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst hats = s(\"hh*8\").bank(\"RolandTR909\").gain(.4)\nconst snare = s(\"~ sd ~ sd\").bank(\"RolandTR909\")\nstack(kick, hats, snare)",
      "tasks": [
        {
          "text": "Done when: closed hats play in bars 1–3 and not at all in bar 4; bar 4 has more snare hits than bar 1.",
          "hint": "hats: s(\"<[hh*8] [hh*8] [hh*8] ~>\"); snare: s(\"<[~ sd ~ sd]!3 [sd*8]>\") or .lastOf(4, x => x.ply(4)).",
          "check": {
            "all": [
              {
                "gte": [
                  {
                    "count": {
                      "s": "hh",
                      "bar": 0
                    }
                  },
                  4
                ]
              },
              {
                "gte": [
                  {
                    "count": {
                      "s": "hh",
                      "bar": 2
                    }
                  },
                  4
                ]
              },
              {
                "eq": [
                  {
                    "count": {
                      "s": "hh",
                      "bar": 3
                    }
                  },
                  0
                ]
              },
              {
                "gt": [
                  {
                    "count": {
                      "s": "sd",
                      "bar": 3
                    }
                  },
                  {
                    "count": {
                      "s": "sd",
                      "bar": 0
                    }
                  }
                ]
              }
            ]
          }
        }
      ],
      "steps": [],
      "solution": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst hats = s(\"<[hh*8] [hh*8] [hh*8] ~>\").bank(\"RolandTR909\").gain(.4)\nconst snare = s(\"~ sd ~ sd\").bank(\"RolandTR909\").lastOf(4, x => x.ply(4))\nstack(kick, hats, snare)",
      "summary": [],
      "introduces": [],
      "teaches": [
        "I19",
        "E3"
      ],
      "tags": [
        "drums",
        "arrangement"
      ],
      "preload": [
        {
          "s": "bd",
          "bank": "RolandTR909"
        },
        {
          "s": "cp",
          "bank": "RolandTR909"
        },
        {
          "s": "hh",
          "bank": "RolandTR909"
        },
        {
          "s": "sd",
          "bank": "RolandTR909"
        }
      ]
    },
    {
      "id": "bass-between-kicks",
      "title": "Never on the kick",
      "goal": "A bassline of at least four notes a bar, none of them on a beat.",
      "concept": "",
      "shape": "kata",
      "starter": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst bass = note(\"c2*4\").s(\"sawtooth\").lpf(600)\nstack(kick, bass)",
      "tasks": [
        {
          "text": "Done when: the kick plays four on the floor and no bass note starts on a beat; at least four bass notes a bar.",
          "hint": "Offbeats and 16ths: note(\"[~ c2] [~ c2 ~ eb2] [~ c2] [~ g1 ~ c2]\").",
          "check": {
            "all": [
              {
                "playsAt": {
                  "at": [
                    0,
                    0.25,
                    0.5,
                    0.75
                  ],
                  "s": "bd"
                }
              },
              {
                "gte": [
                  {
                    "count": {
                      "s": "sawtooth"
                    }
                  },
                  4
                ]
              },
              {
                "not": {
                  "some": {
                    "sel": {
                      "s": "sawtooth"
                    },
                    "where": [
                      {
                        "key": "$time",
                        "in": [
                          0,
                          0.25,
                          0.5,
                          0.75
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      ],
      "steps": [],
      "solution": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst bass = note(\"[~ c2] [~ c2 ~ eb2] [~ c2] [~ g1 ~ c2]\").s(\"sawtooth\").lpf(600)\nstack(kick, bass)",
      "summary": [],
      "introduces": [],
      "teaches": [
        "I8",
        "B12"
      ],
      "tags": [
        "bass"
      ],
      "preload": [
        {
          "s": "bd",
          "bank": "RolandTR909"
        }
      ]
    },
    {
      "id": "own-orbits",
      "title": "Three orbits",
      "goal": "Three parts, each on its own orbit, nothing louder than .7.",
      "concept": "",
      "shape": "kata",
      "starter": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst clap = s(\"~ cp ~ cp\").bank(\"RolandTR909\")\nconst hats = s(\"[~ oh]*4\").bank(\"RolandTR909\")\nstack(kick, clap, hats)",
      "tasks": [
        {
          "text": "Done when: the three parts use three different orbits and every part has a gain of .7 or less.",
          "hint": ".orbit(1), .orbit(2), .orbit(3), and .gain(.7) or lower on each line.",
          "check": {
            "all": [
              {
                "gte": [
                  {
                    "distinct": {
                      "sel": {},
                      "key": "orbit"
                    }
                  },
                  3
                ]
              },
              {
                "every": {
                  "sel": {},
                  "where": [
                    {
                      "key": "gain",
                      "lte": 0.7,
                      "default": 0.8
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "steps": [],
      "solution": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\").gain(.7).orbit(1)\nconst clap = s(\"~ cp ~ cp\").bank(\"RolandTR909\").gain(.6).orbit(2)\nconst hats = s(\"[~ oh]*4\").bank(\"RolandTR909\").gain(.5).orbit(3)\nstack(kick, clap, hats)",
      "summary": [],
      "introduces": [],
      "teaches": [
        "E12",
        "E10"
      ],
      "tags": [
        "mixing"
      ],
      "preload": [
        {
          "s": "bd",
          "bank": "RolandTR909"
        },
        {
          "s": "cp",
          "bank": "RolandTR909"
        },
        {
          "s": "oh",
          "bank": "RolandTR909"
        }
      ]
    },
    {
      "id": "two-chords-a-minor",
      "title": "Two chords in A minor",
      "goal": "A two-chord progression in A minor, each chord lasting two bars.",
      "concept": "",
      "shape": "kata",
      "starter": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst stab = chord(\"Am7\").voicing().struct(\"[~ x]*2\").s(\"sawtooth\").lpf(1500)\nstack(kick, stab)",
      "tasks": [
        {
          "text": "Done when: every note is in A minor, bars 1 and 2 share a chord, and bar 3 has a different one.",
          "hint": "chord(\"<Am7!2 Dm7!2>\") keeps each chord for two bars.",
          "check": {
            "all": [
              {
                "inKey": {
                  "key": "A:minor",
                  "sel": {
                    "s": "sawtooth"
                  }
                }
              },
              {
                "gte": [
                  {
                    "maxChordSize": true
                  },
                  3
                ]
              },
              {
                "eq": [
                  {
                    "values": {
                      "sel": {
                        "s": "sawtooth",
                        "bar": 0
                      },
                      "key": "$pc",
                      "unique": true,
                      "sorted": true
                    }
                  },
                  {
                    "values": {
                      "sel": {
                        "s": "sawtooth",
                        "bar": 1
                      },
                      "key": "$pc",
                      "unique": true,
                      "sorted": true
                    }
                  }
                ]
              },
              {
                "neq": [
                  {
                    "values": {
                      "sel": {
                        "s": "sawtooth",
                        "bar": 0
                      },
                      "key": "$pc",
                      "unique": true,
                      "sorted": true
                    }
                  },
                  {
                    "values": {
                      "sel": {
                        "s": "sawtooth",
                        "bar": 2
                      },
                      "key": "$pc",
                      "unique": true,
                      "sorted": true
                    }
                  }
                ]
              }
            ]
          }
        }
      ],
      "steps": [],
      "solution": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst stab = chord(\"<Am7!2 Dm7!2>\").voicing().struct(\"[~ x]*2\").s(\"sawtooth\").lpf(1500)\nstack(kick, stab)",
      "summary": [],
      "introduces": [],
      "teaches": [
        "I7",
        "I5"
      ],
      "tags": [
        "chords"
