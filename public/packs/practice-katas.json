    {
      "id": "the-breakdown",
      "title": "The breakdown",
      "goal": "A 24-bar arrangement: 8 bars of groove, 8 bars of breakdown with no kick, 8 bars of groove.",
      "concept": "",
      "shape": "kata",
      "starter": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst clap = s(\"~ cp ~ cp\").bank(\"RolandTR909\")\nconst stab = note(\"[~ [c3,eb3,g3]]*2\").s(\"sawtooth\").lpf(1200).decay(.2).sustain(0)\nstack(kick, clap, stab)",
      "tasks": [
        {
          "text": "Done when: the code ends in arrange(…) with three 8-bar sections; bar 9 has the stab but no kick; bars 1 and 17 have the kick.",
          "hint": "const groove = stack(kick, clap, stab); const breakdown = stack(clap, stab); arrange([8, groove], [8, breakdown], [8, groove])",
          "check": {
            "all": [
              {
                "final": "arrange"
              },
              {
                "gte": [
                  {
                    "rows": true
                  },
                  3
                ]
              },
              {
                "eq": [
                  {
                    "rowBars": 0
                  },
                  8
                ]
              },
              {
                "eq": [
                  {
                    "rowBars": 1
                  },
                  8
                ]
              },
              {
                "eq": [
                  {
                    "rowBars": 2
                  },
                  8
                ]
              },
              {
                "gt": [
                  {
                    "count": {
                      "s": "bd",
                      "bar": 0
                    }
                  },
                  0
                ]
              },
              {
                "eq": [
                  {
                    "count": {
                      "s": "bd",
                      "bar": 8
                    }
                  },
                  0
                ]
              },
              {
                "some": {
                  "sel": {
                    "s": "sawtooth",
                    "bar": 8
                  }
                }
              },
              {
                "gt": [
                  {
                    "count": {
                      "s": "bd",
                      "bar": 16
                    }
                  },
                  0
                ]
              }
            ]
          }
        }
      ],
      "steps": [],
      "solution": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst clap = s(\"~ cp ~ cp\").bank(\"RolandTR909\")\nconst stab = note(\"[~ [c3,eb3,g3]]*2\").s(\"sawtooth\").lpf(1200).decay(.2).sustain(0)\nconst groove = stack(kick, clap, stab)\nconst breakdown = stack(clap, stab)\narrange([8, groove], [8, breakdown], [8, groove])",
      "summary": [],
