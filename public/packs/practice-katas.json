    {
      "id": "four-accents-303",
      "title": "Four accents",
      "goal": "A 16-step 303 line with exactly four accented steps.",
      "concept": "",
      "shape": "kata",
      "starter": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst acid = note(\"[c2 c2 c3 c2] [eb2 c2 c3 g1] [c2 ~ bb2 c2] [c3 c2 eb2 g2]\").s(\"sawtooth\").ftype(\"ladder\").lpf(600).lpq(18).lpenv(4).lpdecay(.15)\nstack(kick, acid)",
      "tasks": [
        {
          "text": "Done when: the line keeps its ladder filter and resonance, and exactly four of its notes have a velocity of .9 or more.",
          "hint": ".velocity(\"[1 .6 .6 .6] [.6 .6 1 .6] [.6 .6 .6 .6] [1 .6 1 .6]\")",
          "check": {
            "all": [
              {
                "every": {
                  "sel": {
                    "s": "sawtooth"
                  },
                  "where": [
                    {
                      "key": "ftype",
                      "eq": "ladder"
                    },
                    {
                      "key": "resonance",
                      "gte": 10,
                      "default": 0
                    }
                  ]
                }
              },
              {
                "eq": [
                  {
                    "count": {
                      "s": "sawtooth",
                      "where": [
                        {
                          "key": "velocity",
                          "gte": 0.9,
                          "default": 1
                        }
                      ]
                    }
                  },
                  4
                ]
              },
              {
                "gte": [
                  {
                    "count": {
                      "s": "sawtooth"
                    }
                  },
                  12
                ]
              }
            ]
          }
        }
      ],
      "steps": [],
      "solution": "setcpm(124/4)\nconst kick = s(\"bd*4\").bank(\"RolandTR909\")\nconst acid = note(\"[c2 c2 c3 c2] [eb2 c2 c3 g1] [c2 ~ bb2 c2] [c3 c2 eb2 g2]\").s(\"sawtooth\").ftype(\"ladder\").lpf(600).lpq(18).lpenv(4).lpdecay(.15)\n  .velocity(\"[1 .6 .6 .6] [.6 .6 1 .6] [.6 .6 .6 .6] [1 .6 1 .6]\")\nstack(kick, acid)",
      "summary": [],
      "introduces": [],
